{
  "name": "collector-app-prototype-one",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "seed": "npx tsx scripts/seed-dummy-account.ts",
    "seed:valuations": "npx tsx scripts/seed-valuations-only.ts",
    "seed:sales": "npx tsx scripts/seed-sales-only.ts",
    "ebay:seller-auth": "npx tsx scripts/ebay-seller-auth.ts",
    "ebay:create-listings": "npx tsx scripts/create-ebay-sandbox-listings.ts",
    "checklist-harvest": "npx tsx scripts/checklist-harvest/cli.ts",
    "checklist-harvest:run": "npx tsx scripts/checklist-harvest/cli.ts run",
    "checklist-harvest:approve": "npx tsx scripts/checklist-harvest/cli.ts approve",
    "pop-lookup-poc": "npx tsx scripts/population-lookup-poc.ts",
    "psa-ingest": "npx tsx scripts/ingest-psa-pop.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:all": "vitest run && npx tsx scripts/model-validation-report.ts",
    "test:models": "vitest run src/lib/player-opportunity src/lib/player-card-opportunity src/lib/model-validation src/lib/card-investment",
    "test:validation": "vitest run src/lib/model-validation",
    "test:validation:player": "vitest run src/lib/model-validation/__tests__/player-opportunity.test.ts",
    "test:validation:card": "vitest run src/lib/model-validation/__tests__/player-card-opportunity.test.ts",
    "test:validation:sensitivity": "vitest run src/lib/model-validation/__tests__/sensitivity.test.ts",
    "test:validation:scenarios": "vitest run src/lib/model-validation/__tests__/player-opportunity.test.ts src/lib/model-validation/__tests__/player-card-opportunity.test.ts src/lib/model-validation/__tests__/seasonality.test.ts src/lib/model-validation/__tests__/market.test.ts",
    "test:validation:data-quality": "vitest run src/lib/model-validation/__tests__/data-quality.test.ts",
    "test:validation:explainability": "vitest run src/lib/model-validation/__tests__/explainability.test.ts",
    "test:validation:regression": "vitest run src/lib/model-validation/__tests__/regression.test.ts",
    "test:backtest": "vitest run src/lib/model-validation/__tests__/backtest.test.ts",
    "test:validation:report": "npx tsx scripts/model-validation-report.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "commander": "^15.0.0",
    "csv-parse": "^7.0.2",
    "csv-stringify": "^6.8.3",
    "lucide-react": "^1.23.0",
    "next": "16.2.10",
    "openai": "^6.45.0",
    "p-limit": "^7.3.1",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.62.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.9.2",
    "shadcn": "^4.13.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
